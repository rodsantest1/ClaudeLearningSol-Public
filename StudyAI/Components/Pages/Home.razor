</style>

@code {
    private bool ShowSettingsPanel = false;

    // → Manage Topics state. EditingTopic holds the ORIGINAL name of whichever
    // topic is mid-rename (null when nothing's being edited) — using the
    // original name rather than an index keeps things correct even if the
    // list order shifts underneath the edit for some reason. TopicError is
    // shared by both Add and Rename since only one of those can be in
    // progress at a time.
    private string? EditingTopic;
    private string EditingTopicValue = "";
    private string NewTopicName = "";
    private string? TopicError;

    // → Feedback for HandleClearTopicHistory — same "one shared message
    // slot" shape as TopicError, just for a non-error outcome. Cleared
    // whenever a different Manage Topics action runs so it can't linger
    // and read as feedback for the wrong action.
    private string? TopicNotice;

    // → Powers the "↺ 3" count shown on each topic's Clear-history button —
    // without this there'd be no way to tell whether a topic's avoid-list is
    // empty, partway to Settings.AvoidListSize, or already at the cap (and
    // therefore already pushing every new question for that topic toward
    // the longer/more-elaborate end — see BuildAvoidClause's comment in
    // ClaudeQuizProvider). Loaded once on page init, which is the only time
    // it can go stale: it's Quiz.razor (a different page/component
    // instance) that actually updates the underlying localStorage entry,
    // and navigating back to Home re-runs OnInitializedAsync anyway.
    private Dictionary<string, int> TopicHistoryCounts = new();

    protected override async Task OnInitializedAsync()
    {
        // Load persisted settings from disk on page init
        var persistedSettings = await SettingsPersistence.LoadSettingsAsync();
        if (persistedSettings != null)
        {
            Settings.Model = persistedSettings.Model;
            Settings.DifficultyFilter = persistedSettings.DifficultyFilter;
            Settings.NumQuestions = persistedSettings.NumQuestions;
            Settings.PrefetchNextQuestion = persistedSettings.PrefetchNextQuestion;
            Settings.Topic = persistedSettings.Topic;
            Settings.Topics = persistedSettings.Topics;
            Settings.PreferredFormat = persistedSettings.PreferredFormat;
            Settings.RecommendationMode = persistedSettings.RecommendationMode;
            Settings.AvoidListSize = persistedSettings.AvoidListSize;
        }

        await RefreshTopicHistoryCountsAsync();
    }

    private int GetTopicHistoryCount(string topic) =>
        TopicHistoryCounts.TryGetValue(topic, out var count) ? count : 0;

    private async Task RefreshTopicHistoryCountsAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string>("localStorage.getItem", "recentPromptsByTopic");
            if (string.IsNullOrEmpty(stored))
            {
                TopicHistoryCounts = new();
                return;
            }

            var byTopic = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, List<string>>>(stored);
            TopicHistoryCounts = byTopic?.ToDictionary(kv => kv.Key, kv => kv.Value.Count) ?? new();
        }
        catch
        {
            // localStorage not available, or old/corrupt data under this key —
            // just show no counts rather than failing page load.
            TopicHistoryCounts = new();
        }
    }

    private void ToggleSettingsPanel()
    {
        ShowSettingsPanel = !ShowSettingsPanel;
    }

    private void HandleModelChange(string? newModel)
    {
        if (!string.IsNullOrEmpty(newModel))
        {
            Settings.Model = newModel;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandleDifficultyChange(ChangeEventArgs e)
    {
        if (e.Value is string newDifficulty)
        {
            Settings.DifficultyFilter = newDifficulty;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandleNumQuestionsChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newNum) && newNum >= 5 && newNum <= 20)
        {
            Settings.NumQuestions = newNum;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandleAvoidListSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize) && newSize >= 1 && newSize <= 15)
        {
            Settings.AvoidListSize = newSize;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandlePrefetchChange(ChangeEventArgs e)
    {
        if (e.Value is bool newValue)
        {
            Settings.PrefetchNextQuestion = newValue;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandleTopicChange(ChangeEventArgs e)
    {
        if (e.Value is string newTopic)
        {
            Settings.Topic = newTopic;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandleFormatChange(ChangeEventArgs e)
    {
        if (e.Value is string newFormat)
        {
            Settings.PreferredFormat = newFormat;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    private void HandleRecommendationModeChange(ChangeEventArgs e)
    {
        if (e.Value is string newMode)
        {
            Settings.RecommendationMode = newMode;
            _ = SettingsPersistence.SaveSettingsAsync(Settings);
            Settings.NotifySettingsChanged();
        }
    }

    // → Manage Topics: Add. The actual list-manipulation logic lives in
    // QuizTopicsLogic (pure, unit tested) — this method just translates its
    // result (or rejection) into UI state and persists.
    private void HandleAddTopic()
    {
        var updated = QuizTopicsLogic.AddTopic(Settings.Topics, NewTopicName);
        if (updated is null)
        {
            TopicError = string.IsNullOrWhiteSpace(NewTopicName)
                ? "Enter a topic name."
                : "That topic already exists.";
            return;
        }

        Settings.Topics = updated;
        NewTopicName = "";
        TopicError = null;
        TopicNotice = null;
        _ = SettingsPersistence.SaveSettingsAsync(Settings);
        Settings.NotifySettingsChanged();
    }

    private void HandleAddTopicKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            HandleAddTopic();
    }

    private void HandleStartEditTopic(string topic)
    {
        EditingTopic = topic;
        EditingTopicValue = topic;
        TopicError = null;
        TopicNotice = null;
    }

    private void HandleCancelEditTopic()
    {
        EditingTopic = null;
        EditingTopicValue = "";
        TopicError = null;
    }

    // → Manage Topics: Rename (Update). Keeps Settings.Topic pointed at the
    // renamed entry if it was the one selected — otherwise the dropdown would
    // silently be "selecting" a name that no longer exists in Settings.Topics.
    private void HandleSaveEditTopic(string originalTopic)
    {
        var updated = QuizTopicsLogic.RenameTopic(Settings.Topics, originalTopic, EditingTopicValue);
        if (updated is null)
        {
            TopicError = string.IsNullOrWhiteSpace(EditingTopicValue)
                ? "Enter a topic name."
                : "That topic already exists.";
            return;
        }

        Settings.Topics = updated;

        if (Settings.Topic == originalTopic)
            Settings.Topic = EditingTopicValue.Trim();

        EditingTopic = null;
        EditingTopicValue = "";
        TopicError = null;
        _ = SettingsPersistence.SaveSettingsAsync(Settings);
        Settings.NotifySettingsChanged();
    }

    private void HandleEditTopicKeyDown(KeyboardEventArgs e, string originalTopic)
    {
        if (e.Key == "Enter")
            HandleSaveEditTopic(originalTopic);
        else if (e.Key == "Escape")
            HandleCancelEditTopic();
    }

    // → Manage Topics: Delete. The one CRUD action with a confirmation step —
    // per the app's existing IJSRuntime usage (Quiz.razor's localStorage
    // avoid-list), the browser's native confirm() does the job without adding
    // a whole second modal component on top of the settings panel. If the
    // deleted topic was the active selection, fall back to "Any topic" rather
    // than leaving Settings.Topic pointed at a name that's now gone.
    private async Task HandleDeleteTopic(string topic)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete the topic \"{topic}\"? This can't be undone.");
        if (!confirmed)
            return;

        Settings.Topics = QuizTopicsLogic.RemoveTopic(Settings.Topics, topic);

        if (Settings.Topic == topic)
            Settings.Topic = "";

        if (EditingTopic == topic)
            HandleCancelEditTopic();

        TopicError = null;
        TopicNotice = null;
        _ = SettingsPersistence.SaveSettingsAsync(Settings);
        Settings.NotifySettingsChanged();
    }

    // → Manage Topics: Clear history. Resets a topic's persisted avoid-list
    // (Quiz.razor's RecentPromptsByTopic, saved to localStorage under the
    // "recentPromptsByTopic" key) back to empty. Reaches directly into that
    // same localStorage key via IJSRuntime — there's no live Quiz.razor
    // instance to talk to from here, and there doesn't need to be, since the
    // avoid-list's only job is to survive in browser storage between visits.
    // Doesn't touch Settings.Topics or Settings.Topic at all — unlike
    // Delete, this can't lose a topic or any quiz progress, just some
    // repeat-avoidance memory, so it skips the confirm() step Delete uses.
    // See RecentHistoryLogic.RemoveTopic and CLAUDE.md for why a topic's
    // avoid-list needs clearing at all: it grows toward a cap of 5 with
    // regular use — even just loading Quiz.razor counts, since a question
    // is generated and shown immediately on page load whether or not it's
    // ever answered — and once full, every future question for that topic
    // stays on the longer/more-elaborate end (see BuildAvoidClause's
    // comment in ClaudeQuizProvider) until it's reset.
    private async Task HandleClearTopicHistory(string topic)
    {
        TopicError = null;

        try
        {
            var stored = await JS.InvokeAsync<string>("localStorage.getItem", "recentPromptsByTopic");
            if (string.IsNullOrEmpty(stored))
            {
                TopicNotice = $"\"{topic}\" had no saved question history to clear.";
                return;
            }

            var byTopic = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, List<string>>>(stored);
            if (byTopic is null || !byTopic.ContainsKey(topic))
            {
                TopicNotice = $"\"{topic}\" had no saved question history to clear.";
                return;
            }

            var updated = RecentHistoryLogic.RemoveTopic(byTopic, topic);
            var json = System.Text.Json.JsonSerializer.Serialize(updated);
            await JS.InvokeVoidAsync("localStorage.setItem", "recentPromptsByTopic", json);

            // → Update the on-screen count immediately rather than waiting for
            // a full page reload to re-run RefreshTopicHistoryCountsAsync.
            TopicHistoryCounts.Remove(topic);

            TopicNotice = $"Cleared \"{topic}\"'s question history — new questions won't avoid old ones anymore.";
        }
        catch
        {
            // localStorage not available (private window, etc.) — nothing to clear anyway.
            TopicNotice = null;
        }
    }
}

