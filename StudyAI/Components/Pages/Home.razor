@page "/"
@using StudyAI.Services
@rendermode InteractiveServer
@inject QuizSettings Settings
@inject SettingsPersistence SettingsPersistence
@inject IJSRuntime JS

<PageTitle>StudyAI</PageTitle>

<div class="home">
    <div class="hero">
        <h1>StudyAI</h1>
        <p>A rudimentary exam trainer. Pick how you want to study.</p>
        <button class="settings-btn" @onclick="ToggleSettingsPanel" title="Open settings">⚙️</button>
    </div>

    @* → Settings panel overlay. Shows prefetch toggle and other optimizations
         the student can experiment with. Raised on top of mode cards with z-index. *@
    @if (ShowSettingsPanel)
    {
        <div class="settings-overlay" @onclick="ToggleSettingsPanel"></div>
        <div class="settings-panel">
            <div class="settings-header">
                <h2>Settings</h2>
                <button class="close-btn" @onclick="ToggleSettingsPanel" title="Close">✕</button>
            </div>

            <div class="settings-content">
                <div class="settings-group">
                    <label class="settings-label-text">Model (applies to all quizzes)</label>
                    <div class="settings-radio-group">
                        <label class="settings-radio">
                            <input type="radio" name="model" value="claude-haiku-4-5"
                                   checked="@(Settings.Model == "claude-haiku-4-5")"
                                   @onchange="e => HandleModelChange(e.Value?.ToString())" />
                            <span>Haiku (fast)</span>
                        </label>
                        <label class="settings-radio">
                            <input type="radio" name="model" value="claude-sonnet-4-5"
                                   checked="@(Settings.Model == "claude-sonnet-4-5")"
                                   @onchange="e => HandleModelChange(e.Value?.ToString())" />
                            <span>Sonnet (quality)</span>
                        </label>
                    </div>
                    <p class="settings-hint">Feel the speed/quality tradeoff. Haiku is faster but less capable.</p>
                </div>

                <div class="settings-group">
                    <label class="settings-label-text">Difficulty (applies to all quizzes)</label>
                    <select @onchange="HandleDifficultyChange" class="settings-select">
                        <option value="Easy" selected="@(Settings.DifficultyFilter == "Easy")">Easy</option>
                        <option value="Medium" selected="@(Settings.DifficultyFilter == "Medium")">Medium</option>
                        <option value="Hard" selected="@(Settings.DifficultyFilter == "Hard")">Hard</option>
                        <option value="Mixed" selected="@(Settings.DifficultyFilter == "Mixed")">Mixed</option>
                    </select>
                    <p class="settings-hint">Choose question difficulty. Mixed randomly selects from all three.</p>
                </div>

                <div class="settings-group">
                    <label class="settings-label-text">Questions per Timed Quiz</label>
                    <input type="number" min="5" max="20" @onchange="HandleNumQuestionsChange"
                           value="@Settings.NumQuestions" class="settings-input" />
                    <p class="settings-hint">Number of questions in a Timed Quiz (5-20).</p>
                </div>

                <div class="settings-group">
                    <label class="settings-label">
                        <input type="checkbox"
                               checked="@Settings.PrefetchNextQuestion"
                               @onchange="HandlePrefetchChange"
                               class="settings-checkbox" />
                        <span>Prefetch next question (Timed Quiz)</span>
                    </label>
                    <p class="settings-hint">
                        When enabled, the next question loads while you're answering. Faster but more API calls.
                    </p>
                </div>

                <div class="settings-group">
                    <label class="settings-label-text">Topic (applies to all quizzes)</label>
                    <select @onchange="HandleTopicChange" class="settings-select">
                        <option value="" selected="@(Settings.Topic == "")">Any topic</option>
                        @foreach (var t in Settings.Topics)
                        {
                            <option value="@t" selected="@(Settings.Topic == t)">@t</option>
                        }
                    </select>
                    <p class="settings-hint">Focus on a specific topic or mix from all.</p>
                </div>

                @* → Manage Topics: CRUD over Settings.Topics, the list the dropdown
                     above is built from. Kept as its own group rather than folded
                     into the dropdown itself, so picking a topic to study and
                     editing the topic list are two clearly separate actions — no
                     risk of an edit/delete click also changing what's selected.
                     Delete uses the browser's native confirm() (same IJSRuntime
                     pattern Quiz.razor already uses for localStorage) instead of a
                     custom modal — a second overlay stacked on top of the settings
                     panel would be more UI than a "are you sure" needs. *@
                <div class="settings-group">
                    <label class="settings-label-text">Manage Topics</label>
                    <div class="topics-list">
                        @foreach (var t in Settings.Topics)
                        {
                            <div class="topic-row">
                                @if (EditingTopic == t)
                                {
                                    <input type="text" class="topic-edit-input"
                                           @bind="EditingTopicValue" @bind:event="oninput"
                                           @onkeydown="e => HandleEditTopicKeyDown(e, t)" />
                                    <button type="button" class="topic-icon-btn topic-save-btn" title="Save"
                                            @onclick="() => HandleSaveEditTopic(t)">✓</button>
                                    <button type="button" class="topic-icon-btn" title="Cancel"
                                            @onclick="HandleCancelEditTopic">✕</button>
                                }
                                else
                                {
                                    <span class="topic-name">@t</span>
                                    <button type="button" class="topic-icon-btn topic-clear-btn" title="Clear this topic's saved question history — a fuller avoid-list nudges Claude toward longer, more-elaborate questions"
                                            @onclick="() => HandleClearTopicHistory(t)">↺ @GetTopicHistoryCount(t)</button>
                                    <button type="button" class="topic-icon-btn" title="Rename"
                                            @onclick="() => HandleStartEditTopic(t)">✎</button>
                                    <button type="button" class="topic-icon-btn topic-delete-btn" title="Delete"
                                            @onclick="() => HandleDeleteTopic(t)">🗑</button>
                                }
                            </div>
                        }
                        @if (Settings.Topics.Count == 0)
                        {
                            <p class="topics-empty">No topics yet — add one below.</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(TopicError))
                    {
                        <p class="settings-error">@TopicError</p>
                    }
                    @if (!string.IsNullOrEmpty(TopicNotice))
                    {
                        <p class="settings-notice">@TopicNotice</p>
                    }

                    <div class="topic-add-row">
                        <input type="text" class="topic-add-input" placeholder="New topic name…"
                               @bind="NewTopicName" @bind:event="oninput"
                               @onkeydown="HandleAddTopicKeyDown" />
                        <button type="button" class="topic-add-btn" @onclick="HandleAddTopic">+ Add</button>
                    </div>
                    <p class="settings-hint">
                        Add, rename, or remove topics offered above. Deleting or renaming the
                        currently-selected topic updates the Topic setting to match.
                    </p>
                </div>

                <div class="settings-group">
                    <label class="settings-label-text">Question Format (applies to all quizzes)</label>
                    <select @onchange="HandleFormatChange" class="settings-select">
                        <option value="Any" selected="@(Settings.PreferredFormat == "Any")">Any (Claude decides)</option>
                        <option value="MultipleChoice" selected="@(Settings.PreferredFormat == "MultipleChoice")">Multiple choice</option>
                        <option value="ShortAnswer" selected="@(Settings.PreferredFormat == "ShortAnswer")">Short answer</option>
                    </select>
                    <p class="settings-hint">Prefer a question format, or let Claude choose what fits best.</p>
                </div>

                <div class="settings-group">
                    <label class="settings-label-text">AI Recommendations (applies to all quizzes)</label>
                    <select @onchange="HandleRecommendationModeChange" class="settings-select">
                        <option value="Disabled" selected="@(Settings.RecommendationMode == "Disabled")">Disabled</option>
                        <option value="Suggested" selected="@(Settings.RecommendationMode == "Suggested")">Show suggestions</option>
                        <option value="Auto" selected="@(Settings.RecommendationMode == "Auto")">Auto-apply</option>
                    </select>
                    <p class="settings-hint">How to handle AI routing suggestions for what topic/difficulty to tackle next.</p>
                </div>

                @* → Configurable avoid-list size (was a fixed constant of 5 in
                     both Quiz.razor and TimedQuiz.razor). Framed honestly in the
                     hint rather than as a pure "more is better" dial — see
                     QuizSettings.AvoidListSize's doc comment for why. *@
                <div class="settings-group">
                    <label class="settings-label-text">Avoid-list size (applies to all quizzes)</label>
                    <input type="number" min="1" max="15" @onchange="HandleAvoidListSizeChange"
                           value="@Settings.AvoidListSize" class="settings-input" />
                    <p class="settings-hint">
                        How many recent questions per topic Claude is told not to repeat (1-15).
                        Higher means fewer repeats, but a longer avoid-list also nudges Claude
                        toward longer, more-elaborate questions once it's full — see the "Clear
                        history" (↺) buttons above if a topic's questions have started feeling
                        long and you'd rather reset it than lower this number.
                    </p>
                </div>
            </div>
        </div>
    }

    @* → Big, distinct cards instead of the old inline text links — each
         mode's accent color matches what that mode already uses once you're
         inside it (purple ties back to app.css's global accent used
         throughout Quiz.razor, blue ties back to TimedQuiz.razor's own
         header/timer blue), so the color carries over instead of resetting
         the moment you land on either page. New class names (mode-*) rather
         than reusing .btn/.home from app.css — see the CSS-collision lesson
         in CLAUDE.md about two things sharing a class name fighting over it;
         these are unique everywhere in the project. *@
    <div class="mode-grid">
        <a class="mode-card mode-card-regular" href="/quiz">
            <span class="mode-icon" aria-hidden="true">📝</span>
            <span class="mode-title">Regular Quiz</span>
            <span class="mode-desc">Go at your own pace. Check answers as you go and mark tricky ones for review.</span>
            <span class="mode-cta">Start quiz <span class="mode-arrow">→</span></span>
        </a>

        <a class="mode-card mode-card-timed" href="/timed-quiz">
            <span class="mode-icon" aria-hidden="true">⏱️</span>
            <span class="mode-title">Timed Quiz</span>
            <span class="mode-desc">Simulate exam conditions with a running clock and a fixed question count.</span>
            <span class="mode-cta">Start quiz <span class="mode-arrow">→</span></span>
        </a>
    </div>
</div>

<style>
