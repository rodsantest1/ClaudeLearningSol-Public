@page "/quiz"
@rendermode InteractiveServer
@inject StudyAI.Services.IQuizProvider QuizProvider
@inject StudyAI.Services.IQuizPlanner QuizPlanner

<PageTitle>Quiz</PageTitle>

<div class="quiz">
    <h1>Quiz</h1>

    <div class="topic-row">
        <select @bind="Topic">
            <option value="">Any topic</option>
            @foreach (var t in Topics)
            {
                <option value="@t">@t</option>
            }
        </select>
        <select @bind="SelectedModel" title="Model tier — affects speed, cost, and answer quality">
            @foreach (var m in Models)
            {
                <option value="@m.Id">@m.Label</option>
            }
        </select>
        <select @bind="SelectedDifficulty" title="Question difficulty">
            @foreach (var d in Difficulties)
            {
                <option value="@d">@d</option>
            }
        </select>
        <select @bind="SelectedFormat" title="Question format preference">
            @foreach (var f in Formats)
            {
                <option value="@f.Value">@f.Label</option>
            }
        </select>
        <select @bind="SelectedRecommendationMode" title="How to handle suggested next">
            @foreach (var r in RecommendationModes)
            {
                <option value="@r.Value">@r.Label</option>
            }
        </select>
        <button @onclick="LoadQuestion" disabled="@(IsLoadingQuestion || IsGrading)">New question</button>
    </div>

    @if (LastQuestionMs is not null)
    {
        <p class="timing">Question generated in @LastQuestionMs ms using @CurrentModelLabel@TokenSuffix(Current?.InputTokens, Current?.OutputTokens)</p>
    }

    @if (IsLoadingQuestion)
    {
        <div class="question loading">
            <div class="spinner"></div>
            <p class="loading-text">Loading question…</p>
        </div>
    }
    else if (Current is not null)
    {
        <div class="question">
            <div class="question-header">
                <p class="topic-tag">@Current.Topic</p>
                <button type="button" class="review-btn @(IsMarkedForReview ? "active" : "")" @onclick="ToggleReview">
                    @(IsMarkedForReview ? "★ Marked for review" : "☆ Mark for review")
                </button>
            </div>
            <p class="prompt">@Current.Prompt</p>

            @if (Current.Choices.Count > 0)
            {
                @foreach (var choice in Current.Choices)
                {
                    var eliminated = EliminatedChoices.Contains(choice);
                    <div class="choice-row">
                        <label class="choice @(eliminated ? "eliminated" : "")">
                            <input type="radio" name="answer" value="@choice"
                                   checked="@(SelectedAnswer == choice)"
                                   disabled="@eliminated"
                                   @onchange="() => SelectedAnswer = choice" />
                            <span>@choice</span>
                        </label>
                        <button type="button" class="eliminate-btn" title="Cross out"
                                @onclick="() => ToggleEliminate(choice)">
                            @(eliminated ? "↺" : "✕")
                        </button>
                    </div>
                }
            }
            else
            {
                <!-- Free-text question (iteration 3): no choices to cross out —
                     there's nothing for process-of-elimination to apply to. -->
                <textarea class="freetext-answer" placeholder="Type your answer…"
                          @bind="SelectedAnswer" @bind:event="oninput"
                          disabled="@(Result is not null)"></textarea>
            }

            <button @onclick="Submit" disabled="@(IsGrading || string.IsNullOrWhiteSpace(SelectedAnswer) || Result is not null)">
                @(IsGrading ? "Grading…" : "Submit")
            </button>
        </div>

        @if (Result is not null)
        {
            <div class="result @ResultCssClass">
                <strong>@ResultLabel</strong>
                <p>@Result.Explanation</p>
            </div>
            @if (LastGradeMs is not null)
            {
                <p class="timing">Graded in @LastGradeMs ms using @CurrentModelLabel@TokenSuffix(Result?.InputTokens, Result?.OutputTokens)</p>
            }

            @if (IsRecommending)
            {
                <p class="loading-text">Thinking about what's next…</p>
            }
            else if (Recommendation is not null && SelectedRecommendationMode != nameof(StudyAI.Models.RecommendationMode.Disabled))
            {
                <div class="recommendation">
                    <p class="recommendation-label">Suggested next</p>
                    <p><strong>@Recommendation.Topic</strong> · @Recommendation.Difficulty — @Recommendation.Reason</p>
                    <button type="button" @onclick="ApplyRecommendation">Use this</button>
                    @if (LastRecommendationMs is not null)
                    {
                        <p class="timing">Recommended in @LastRecommendationMs ms using @CurrentModelLabel@TokenSuffix(Recommendation.InputTokens, Recommendation.OutputTokens)</p>
                    }
                </div>
            }
        }
    }

    <p class="score">Score: @CorrectCount / @TotalCount</p>

    @if (SessionCalls > 0)
    {
        <p class="session-stats">
            Session: @SessionCalls API calls · @SessionElapsedMs ms total (@(SessionElapsedMs / SessionCalls) ms avg) ·
            @(SessionInputTokens + SessionOutputTokens) tokens total (@SessionInputTokens in / @SessionOutputTokens out)
        </p>
    }

    @if (MarkedForReview.Count > 0)
    {
        <div class="marked-list">
            <p class="marked-heading">Marked for review (@MarkedForReview.Count)</p>
            <ul>
                @foreach (var q in MarkedForReview)
                {
                    <li><span class="marked-topic">@q.Topic</span> — @q.Prompt</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    private static readonly string[] Topics = { "C# Basics", "Web Fundamentals", "Databases", "Claude Certified Developer" };

    // Model Selection and Optimization (CCDV-F, 16.8%): two tiers, not more —
    // the point is to feel the gap between "fast and cheap" and "slower and
    // more capable," not to catalog every model Anthropic offers.
    private static readonly (string Id, string Label)[] Models =
    {
        ("claude-haiku-4-5-20251001", "Fast (Haiku)"),
        ("claude-sonnet-4-5", "Balanced (Sonnet)"),
    };

    private static readonly string[] Difficulties = { "Easy", "Medium", "Hard" };

    // Tools and MCPs (CCDV-F, 10.6%): question format preference. Demonstrates
    // how tool selection (which tools to offer Claude) is a control lever,
    // not just how tools are defined. QuestionFormat.Any is the default,
    // matching iteration 5's tool_choice: "auto" behavior where Claude picks.
    private static readonly (string Value, string Label)[] Formats =
    {
        (nameof(StudyAI.Models.QuestionFormat.Any), "Any format"),
        (nameof(StudyAI.Models.QuestionFormat.MultipleChoice), "Multiple choice only"),
        (nameof(StudyAI.Models.QuestionFormat.ShortAnswer), "Short answer only"),
    };

    // Agents and Workflows (CCDV-F, 14.7%): recommendation mode controls how
    // ClaudeQuizPlanner's routing decisions are applied. Auto lets Claude
    // recommend any topic; StayOnTopic constrains recommendations to the
    // current topic (useful for focused practice); Disabled skips recommendations
    // entirely so users manually pick their path. This demonstrates that even
    // a fixed workflow (routing after every grade) can be made flexible by
    // letting users control *how* the routing works, not just whether it fires.
    private static readonly (string Value, string Label)[] RecommendationModes =
    {
        (nameof(StudyAI.Models.RecommendationMode.Auto), "Auto-recommend (any topic)"),
        (nameof(StudyAI.Models.RecommendationMode.StayOnTopic), "Stay on current topic"),
        (nameof(StudyAI.Models.RecommendationMode.Disabled), "Disabled (manual only)"),
    };

    private string Topic = "Claude Certified Developer";
    private string SelectedModel = Models[0].Id; // Haiku
    private string SelectedDifficulty = "Easy";
    private string SelectedFormat = nameof(StudyAI.Models.QuestionFormat.MultipleChoice);
    private string SelectedRecommendationMode = nameof(StudyAI.Models.RecommendationMode.StayOnTopic);
    private QuizQuestion? Current;
    private string? SelectedAnswer;
    private GradeResult? Result;
    private bool IsLoadingQuestion;
    private bool IsGrading;
    private int CorrectCount;
    private int TotalCount;
    private long? LastQuestionMs;
    private long? LastGradeMs;

    // Prompt and Context Engineering (CCDV-F, 11.0%): the app has no server-
    // side session state Claude can read, so "don't repeat yourself" has to be
    // fed back in as prompt content — a rolling list of the last few prompts
    // actually shown, replayed into GetQuestionAsync so ClaudeQuizProvider can
    // tell Claude what to avoid. Capped so the prompt doesn't grow unbounded
    // over a long study session. Cleared here isn't needed (LoadQuestion adds
    // to it, never resets it) — the list is meant to span the whole session,
    // not just the current question.
    private const int MaxRecentPrompts = 5;
    private readonly Queue<string> RecentPrompts = new();

    // Tools and MCPs (CCDV-F, 10.6%): track the format of recent questions so
    // the app can nudge Claude toward formats it hasn't been using as much,
    // without any server-side state — the caller replays back the actual
    // recent history so the implementation can self-correct. Same shape as
    // RecentPrompts, same cap, same lifecycle (cleared only at session end).
    // the actual recent distribution back in lets Claude self-correct against
    // real history instead of a one-size-fits-all static preference.
    private readonly Queue<bool> RecentFormats = new();

    // Agents and Workflows (CCDV-F, 14.7%): per-topic running score, kept only
    // in memory for this session — the input side of the routing decision.
    // IQuizPlanner reads a snapshot of this after every grade to decide what
    // to recommend next.
    private readonly Dictionary<string, (int Correct, int Total)> TopicStats = new();
    private NextStepRecommendation? Recommendation;
    private bool IsRecommending;
    private long? LastRecommendationMs;

    // Session-wide aggregate, shown outside the question card — the per-call
    // lines above answer "was this one fast/expensive?"; this answers "what's
    // this session actually costing me?" Both generation and grading calls
    // count toward it. Model Selection and Optimization (CCDV-F, 16.8%).
    private int SessionCalls;
    private long SessionElapsedMs;
    private int SessionInputTokens;
    private int SessionOutputTokens;

    private string CurrentModelLabel =>
        Models.FirstOrDefault(m => m.Id == SelectedModel).Label ?? SelectedModel;

    private static string TokenSuffix(int? inputTokens, int? outputTokens) =>
        inputTokens is null || outputTokens is null
            ? ""
            : $" · {inputTokens}/{outputTokens} tokens (in/out)";

    // Eval, Testing, and Debugging (CCDV-F, 2.6%): a third visible state next
    // to "correct"/"incorrect" — GradeResult.Outcome is what makes this
    // distinguishable at all now instead of a failed grade just rendering as
    // "Not quite" and quietly costing a point (see Submit below).
    private string ResultCssClass => Result?.Outcome switch
    {
        GradeOutcome.Correct => "correct",
        GradeOutcome.Incorrect => "incorrect",
        GradeOutcome.GradingFailed => "failed",
        _ => "",
    };

    private string ResultLabel => Result?.Outcome switch
    {
        GradeOutcome.Correct => "Correct",
        GradeOutcome.Incorrect => "Not quite",
        GradeOutcome.GradingFailed => "Grading failed",
        _ => "",
    };

    private void RecordCall(long elapsedMs, int? inputTokens, int? outputTokens)
    {
        SessionCalls++;
        SessionElapsedMs += elapsedMs;
        SessionInputTokens += inputTokens ?? 0;
        SessionOutputTokens += outputTokens ?? 0;
    }

    // Process-of-elimination scratch marks — purely visual/local to the current
    // question, reset every time a new one loads. Doesn't affect grading.
    private readonly HashSet<string> EliminatedChoices = new();

    // Mark-for-review is a running list, not a navigator — there's no back
    // button in this flow yet, so "marking" just keeps a visible list of what
    // to revisit later rather than letting you jump back into it here.
    private bool IsMarkedForReview;
    private readonly List<QuizQuestion> MarkedForReview = new();

    protected override async Task OnInitializedAsync()
    {
        // Don't load a question automatically — let the user click "New question"
        // to start. This gives them time to choose topic/model/difficulty/format first.
        await Task.CompletedTask;
    }

    private async Task LoadQuestion()
    {
        IsLoadingQuestion = true;
        Current = null;
        SelectedAnswer = null;
        Result = null;
        LastQuestionMs = null;
        LastGradeMs = null;
        Recommendation = null;
        LastRecommendationMs = null;
        EliminatedChoices.Clear();
        IsMarkedForReview = false;

        // Tools and MCPs (CCDV-F, 10.6%): parse the selected format string
        // back into the enum and pass it to GetQuestionAsync. This demonstrates
        // tool selection as a control point — the caller (UI) decides which
        // tools to offer Claude, not just how to prompt it.
        var preferredFormat = Enum.Parse<StudyAI.Models.QuestionFormat>(SelectedFormat);

        // Timed on purpose: a dropdown that silently changes an API parameter
        // teaches nothing. Seeing Haiku consistently beat Sonnet here is what
        // makes the cost/speed/quality tradeoff real instead of theoretical.
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        Current = await QuizProvider.GetQuestionAsync(Topic, SelectedModel, SelectedDifficulty, RecentPrompts.ToList(), RecentFormats.ToList(), preferredFormat);
        stopwatch.Stop();
        LastQuestionMs = stopwatch.ElapsedMilliseconds;
        RecordCall(LastQuestionMs.Value, Current.InputTokens, Current.OutputTokens);

        // "Setup needed" is ErrorQuestion's sentinel topic (ClaudeQuizProvider) —
        // skip adding failed/error placeholders to the avoid-list, since they're
        // not real questions Claude generated and have nothing worth avoiding.
        if (Current.Topic != "Setup needed")
        {
            RecentPrompts.Enqueue(Current.Prompt);
            while (RecentPrompts.Count > MaxRecentPrompts)
                RecentPrompts.Dequeue();

            RecentFormats.Enqueue(Current.Choices.Count > 0);
            while (RecentFormats.Count > MaxRecentPrompts)
                RecentFormats.Dequeue();
        }

        IsLoadingQuestion = false;
    }

    private void ToggleEliminate(string choice)
    {
        if (!EliminatedChoices.Remove(choice))
            EliminatedChoices.Add(choice);

        if (SelectedAnswer == choice && EliminatedChoices.Contains(choice))
            SelectedAnswer = null;
    }

    private void ToggleReview()
    {
        if (Current is null) return;

        IsMarkedForReview = !IsMarkedForReview;

        if (IsMarkedForReview)
            MarkedForReview.Add(Current);
        else
            MarkedForReview.Remove(Current);
    }

    private async Task Submit()
    {
        if (Current is null || SelectedAnswer is null) return;
        IsGrading = true;

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        Result = await QuizProvider.GradeAsync(Current, SelectedAnswer, SelectedModel);
        stopwatch.Stop();
        LastGradeMs = stopwatch.ElapsedMilliseconds;
        RecordCall(LastGradeMs.Value, Result.InputTokens, Result.OutputTokens);
        IsGrading = false;

        // Eval, Testing, and Debugging (CCDV-F, 2.6%): a truncated or
        // unparseable grade used to silently count as "incorrect" — it
        // touched the score and TopicStats exactly like a real wrong answer.
        // GradeResult.Outcome now says explicitly when grading itself failed,
        // so that case skips the score, skips feeding a bad data point into
        // TopicStats, and skips triggering a recommendation call that would
        // just be reasoning off the same numbers as last time.
        if (Result.Outcome == GradeOutcome.GradingFailed)
            return;

        TotalCount++;
        if (Result.IsCorrect) CorrectCount++;

        TopicStats.TryGetValue(Current.Topic, out var stats);
        TopicStats[Current.Topic] = (stats.Correct + (Result.IsCorrect ? 1 : 0), stats.Total + 1);

        await Recommend();
    }

    // Agents and Workflows (CCDV-F, 14.7%): fires after every grade based on
    // SelectedRecommendationMode. When Disabled, skips the recommendation call
    // entirely. When StayOnTopic, passes only the current topic to the planner.
    // When Auto, passes full history for unrestricted routing. This demonstrates
    // that workflows can be flexible — the same IQuizPlanner implementation
    // behaves differently based on what input the caller provides (or chooses
    // not to call at all).
    private async Task Recommend()
    {
        var mode = Enum.Parse<StudyAI.Models.RecommendationMode>(SelectedRecommendationMode);

        if (mode == StudyAI.Models.RecommendationMode.Disabled)
        {
            Recommendation = null;
            return;
        }

        IsRecommending = true;

        var history = mode == StudyAI.Models.RecommendationMode.StayOnTopic
            ? new List<StudyAI.Models.TopicPerformance>
            {
                TopicStats
                    .Where(kv => kv.Key == Current.Topic)
                    .Select(kv => new StudyAI.Models.TopicPerformance(kv.Key, kv.Value.Correct, kv.Value.Total))
                    .FirstOrDefault() ?? new StudyAI.Models.TopicPerformance(Current.Topic, 0, 0)
            }
            : TopicStats
                .Select(kv => new StudyAI.Models.TopicPerformance(kv.Key, kv.Value.Correct, kv.Value.Total))
                .ToList();

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        var restrictToCurrentTopic = mode == StudyAI.Models.RecommendationMode.StayOnTopic;
        Recommendation = await QuizPlanner.RecommendNextAsync(history, SelectedModel, restrictToCurrentTopic);
        stopwatch.Stop();
        LastRecommendationMs = stopwatch.ElapsedMilliseconds;
        RecordCall(LastRecommendationMs.Value, Recommendation.InputTokens, Recommendation.OutputTokens);

        IsRecommending = false;
    }

    private async Task ApplyRecommendation()
    {
        if (Recommendation is null) return;

        Topic = Recommendation.Topic;
        SelectedDifficulty = NormalizeDifficulty(Recommendation.Difficulty);
        await LoadQuestion();
    }

    // Claude's free-text difficulty won't always match the dropdown's casing
    // exactly (e.g. "medium" vs "Medium") — normalized here so the <select>
    // shows a real selection instead of silently landing on nothing.
    private static string NormalizeDifficulty(string value) =>
        Difficulties.FirstOrDefault(d => string.Equals(d, value, StringComparison.OrdinalIgnoreCase)) ?? "Medium";
}
