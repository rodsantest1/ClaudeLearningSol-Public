        color: #666;
        margin: 0 0 1.5rem;
        font-size: 0.95rem;
        text-align: center;
    }

    .field {
        margin-bottom: 1.1rem;
    }

    .field label:not(.checkbox-label) {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #444;
    }

    .field select,
    .field input[type="number"] {
        width: 100%;
        padding: 0.6rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 0.95rem;
        font-family: inherit;
        box-sizing: border-box;
    }

    .checkbox-field .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        cursor: pointer;
        font-size: 0.9rem;
        color: #333;
        font-weight: 500;
    }

    .checkbox-field input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .inline-number {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        margin-left: 1.6rem;
    }

    .inline-number input {
        width: 90px;
        padding: 0.4rem 0.6rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .inline-number span {
        font-size: 0.85rem;
        color: #666;
    }

    .validation-error {
        color: #c62828;
