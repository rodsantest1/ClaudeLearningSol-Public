@* TimedQuizConfigForm.razor
    The screen QuickStartOrConfigure's "Configure" button was supposed to lead
    to. It never actually did anything — TimedQuiz.razor's HandleConfigure()
    was an empty method with a comment claiming this was "handled by
    setupComponent," but nothing on either side ever built a config screen.
    This component is that screen: lets the student customize question count,
    topic, difficulty, format, and optional time limits before starting, then
    hands the built TimedQuizConfig back to the parent to actually start the quiz.

    Settings are remembered across visits via localStorage (same pattern
    Quiz.razor already uses for its avoid-list) — reconfiguring every time
    you want a timed run is exactly the kind of friction Quick Start exists
    to skip, so Configure shouldn't reset to defaults every time either.
*@
@inject IJSRuntime JS

<div class="config-container">
    <div class="config-card">
        <h2>Configure Timed Quiz</h2>
        <p class="subtitle">Set up your quiz session, then start when ready.</p>

        <div class="field">
            <label for="numQuestions">Number of questions</label>
            <input id="numQuestions" type="number" min="1" max="50" @bind="NumQuestions" />
        </div>

        <div class="field">
            <label for="topic">Topic</label>
            <select id="topic" @bind="Topic">
                <option value="">Any topic</option>
                @foreach (var t in Topics)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="difficulty">Difficulty</label>
            <select id="difficulty" @bind="DifficultyFilter">
                <option value="Mixed">Mixed</option>
                <option value="Easy">Easy</option>
                <option value="Medium">Medium</option>
                <option value="Hard">Hard</option>
            </select>
        </div>

        <div class="field">
            <label for="format">Question format</label>
            <select id="format" @bind="PreferredFormat">
                <option value="@nameof(StudyAI.Models.QuestionFormat.Any)">Any format</option>
                <option value="@nameof(StudyAI.Models.QuestionFormat.MultipleChoice)">Multiple choice only</option>
                <option value="@nameof(StudyAI.Models.QuestionFormat.ShortAnswer)">Short answer only</option>
            </select>
        </div>

        <div class="field checkbox-field">
            <label class="checkbox-label">
                <input type="checkbox" checked="@HasTimePerQuestion" @onchange="(ChangeEventArgs e) => HasTimePerQuestion = (bool)e.Value!" />
                <span>Limit time per question</span>
            </label>
            @if (HasTimePerQuestion)
            {
                <div class="inline-number">
                    <input type="number" min="5" max="600" @bind="TimePerQuestionSeconds" />
                    <span>seconds</span>
                </div>
            }
        </div>

        <div class="field checkbox-field">
            <label class="checkbox-label">
                <input type="checkbox" checked="@HasTotalTime" @onchange="(ChangeEventArgs e) => HasTotalTime = (bool)e.Value!" />
                <span>Limit total quiz time</span>
            </label>
            @if (HasTotalTime)
            {
                <div class="inline-number">
                    <input type="number" min="30" max="14400" @bind="TotalTimeSeconds" />
                    <span>seconds</span>
                </div>
            }
        </div>

        @if (!IsValid)
        {
            <p class="validation-error">Number of questions must be between 1 and 50.</p>
        }

        <div class="action-buttons">
            <button class="btn btn-primary" @onclick="StartClicked" disabled="@(!IsValid)">
                Start Quiz
            </button>
            <button class="btn btn-outline" @onclick="OnCancel">
                Back
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<StudyAI.Models.TimedQuizConfig> OnStart { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    // Same topic list Quiz.razor offers, so "topic" means the same thing in
    // both modes rather than each page inventing its own vocabulary.
    private static readonly string[] Topics = { "C# Basics", "Web Fundamentals", "Databases", "Claude Certified Developer" };

    // Defaults mirror TimedQuizConfig.QuickStart() — Configure starts from
    // the same baseline Quick Start uses, not a blank/zeroed form.
    private int NumQuestions = 10;
    private string Topic = "";
    private string DifficultyFilter = "Mixed";
    private string PreferredFormat = nameof(StudyAI.Models.QuestionFormat.Any);
    private bool HasTimePerQuestion = false;
    private int TimePerQuestionSeconds = 60;
    private bool HasTotalTime = false;
    private int TotalTimeSeconds = 600;

    private bool IsValid => NumQuestions >= 1 && NumQuestions <= 50;

    // → Same key/pattern Quiz.razor uses for its "recentPrompts" avoid-list —
    // one localStorage entry, read on load, written on Start.
    private const string StorageKey = "timedQuizConfig";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrEmpty(stored))
            {
                var saved = System.Text.Json.JsonSerializer.Deserialize<StudyAI.Models.TimedQuizConfig>(stored);
                if (saved != null)
                {
                    NumQuestions = saved.NumQuestions;
                    Topic = saved.Topic;
                    DifficultyFilter = saved.DifficultyFilter;
                    PreferredFormat = saved.PreferredFormat.ToString();
                    HasTimePerQuestion = saved.TimePerQuestionSeconds.HasValue;
                    TimePerQuestionSeconds = saved.TimePerQuestionSeconds ?? TimePerQuestionSeconds;
                    HasTotalTime = saved.TotalTimeSeconds.HasValue;
                    TotalTimeSeconds = saved.TotalTimeSeconds ?? TotalTimeSeconds;
                }
            }
        }
        catch
        {
            // localStorage not available (private window, etc.) — just keep the built-in defaults.
        }
    }

    private async Task StartClicked()
    {
        if (!IsValid) return;

        var config = new StudyAI.Models.TimedQuizConfig
        {
            NumQuestions = NumQuestions,
            Topic = Topic,
            DifficultyFilter = DifficultyFilter,
            PreferredFormat = Enum.Parse<StudyAI.Models.QuestionFormat>(PreferredFormat),
            TimePerQuestionSeconds = HasTimePerQuestion ? TimePerQuestionSeconds : null,
            TotalTimeSeconds = HasTotalTime ? TotalTimeSeconds : null,
        };

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(config);
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
        }
        catch
        {
            // localStorage not available — the quiz still starts fine, it just won't be remembered next time.
        }

        await OnStart.InvokeAsync(config);
    }
}

<style>
